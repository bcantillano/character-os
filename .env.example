# Character OS environment
# Copy to .env and fill in values. Never commit .env.

# Default LLM provider for Phase 1 (openai | stub)
# Prefer: character-os --provider openai
CHARACTER_OS_LLM_PROVIDER=stub

# Required when CHARACTER_OS_LLM_PROVIDER=openai or --provider openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Character and tick defaults
CHARACTER_OS_CHARACTER=captain-redbeard
CHARACTER_OS_TICK_INTERVAL_SECONDS=30

# Optional: print Observe→Act stage lines on stderr (also --debug-stages)
# CHARACTER_OS_DEBUG_STAGES=1

# Phase 1b TTS (also --tts / --tts-play)
# CHARACTER_OS_TTS=1
# CHARACTER_OS_TTS_PROVIDER=openai

# Phase 3 STT (also --stt / --stt-file / /listen)
# CHARACTER_OS_STT=1
# CHARACTER_OS_STT_PROVIDER=stub
# CHARACTER_OS_STT_MODEL=whisper-1
