# Character OS environment
# Copy to .env and fill in values. Never commit .env.

# Default LLM provider for Phase 1 (openai | stub)
CHARACTER_OS_LLM_PROVIDER=stub

# Required when CHARACTER_OS_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Character and tick defaults
CHARACTER_OS_CHARACTER=captain-redbeard
CHARACTER_OS_TICK_INTERVAL_SECONDS=30
